---
/**
 * País (/pais/{slug}) — todas as obras de autorias de um país (handoff §6.7):
 * voltar para o Atlas por país, chips de países com o mesmo idioma dominante,
 * nome em Bodoni 700 na cor do idioma (clareada para ler sobre o fundo escuro,
 * com filete na cor exata), frase opcional (só se aprovada), big numbers,
 * destaque da autoria mais lida e a grade. Sem ordenação.
 */
import Base from "@/layouts/Base.astro";
import BigNumbers from "@/components/BigNumbers.astro";
import AuthorChip from "@/components/AuthorChip.astro";
import WorkGrid from "@/components/WorkGrid.astro";
import { getCatalog } from "@/lib/catalog/index.ts";
import {
  buildCountryPages,
  readingsLabel,
  type CountryPage,
} from "@/lib/atlas.ts";

export function getStaticPaths() {
  return buildCountryPages(getCatalog()).map((page) => ({
    params: { slug: page.slug },
    props: { page },
  }));
}

const { page } = Astro.props as { page: CountryPage };
---

<Base title={`${page.name} · A estante da Lila`}>
  <header class="top">
    <a class="back" href="/atlas/pais">‹ Atlas</a>

    {
      page.sharing && (
        <nav class="sharing" aria-label="Países com o mesmo idioma">
          <ul>
            {page.sharing.map((c) => (
              <li>
                <a class="chip" href={c.href}>
                  {c.name}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }

    <h1 class="name" style={`color:${page.nameColor};`}>{page.name}</h1>
    <span class="swatch" style={`background:${page.swatch};`} aria-hidden="true"
    ></span>

    {page.summary && <p class="t-body summary">{page.summary}</p>}
  </header>

  <main class="country">
    <BigNumbers items={page.numbers} label="Números do país" />

    {
      page.topAuthor && (
        <section class="top-author" aria-labelledby="top-author-title">
          <h2 id="top-author-title" class="t-section-title">
            Quem ela mais lê aqui
          </h2>
          <AuthorChip
            author={page.topAuthor.author}
            href={page.topAuthor.href}
            layout="row"
            size={56}
            meta={readingsLabel(page.topAuthor.readings)}
          />
        </section>
      )
    }

    <WorkGrid items={page.items} />
  </main>
</Base>

<style>
  .top {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 4px var(--gutter) 8px;
  }
  .back {
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
    min-height: var(--tap);
    color: var(--muted);
    font-family: var(--font-ui);
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
  }
  .back:hover {
    color: var(--text);
  }
  .sharing ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .chip {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    padding: 0 14px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--border);
    color: var(--text);
    font-family: var(--font-ui);
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
  }
  .chip:hover {
    border-color: var(--text);
  }
  .name {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(44px, 14vw, 68px);
    line-height: 0.95;
    letter-spacing: -0.02em;
    overflow-wrap: anywhere;
  }
  .swatch {
    display: block;
    width: 64px;
    height: 4px;
    border-radius: 2px;
  }
  .summary {
    margin: 4px 0 0;
    color: var(--text);
    max-width: 62ch;
  }

  .country {
    display: flex;
    flex-direction: column;
    gap: 28px;
    padding: 16px var(--gutter) 48px;
  }
  .top-author {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .top-author h2 {
    color: var(--title);
  }

  @media (min-width: 760px) {
    .top,
    .country {
      max-width: 960px;
      margin-inline: auto;
      width: 100%;
    }
  }
</style>
