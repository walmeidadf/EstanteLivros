---
/**
 * Capa — imagem 2:3 com corte central quando há um mestre local derivável;
 * senão, delega para a capa tipográfica (handoff §4, §8). Selo "2×" opcional
 * para releituras. O `src` é sempre o derivado local (R6.4).
 *
 * Na S1 nenhuma capa de OBRA foi baixada ainda, então o caminho normal é a
 * capa tipográfica. O componente já aceita um mestre derivado para quando as
 * capas entrarem (mesma assinatura de imagem usada no avatar).
 */
import TypographicCover from "@/components/TypographicCover.astro";
import type { DerivedImage } from "@/lib/images.ts";

interface Props {
  title: string;
  language: string;
  originalTitle?: string | null;
  author?: string;
  /** Imagem derivada no build; ausente/null → capa tipográfica. */
  image?: DerivedImage | null;
  /** Selo "2×" no canto (releitura). */
  rereadBadge?: boolean;
  size?: "hero" | "rail" | "grid";
}

const {
  title,
  language,
  originalTitle = null,
  author = "",
  image = null,
  rereadBadge = false,
  size = "grid",
} = Astro.props;
---

<div class:list={["cover-frame", `size-${size}`]}>
  {
    image ? (
      <img
        class="cover-img"
        src={image.src}
        srcset={image.srcset}
        width={image.width}
        height={image.height}
        alt={title}
        loading="lazy"
        decoding="async"
      />
    ) : (
      <TypographicCover
        title={title}
        language={language}
        originalTitle={originalTitle}
        author={author}
        size={size}
      />
    )
  }
  {
    rereadBadge && (
      <span class="badge" aria-hidden="true">
        2×
      </span>
    )
  }
</div>

<style>
  .cover-frame {
    position: relative;
    aspect-ratio: var(--cover-ratio);
  }
  .size-hero {
    width: var(--cover-hero-w);
  }
  .size-rail {
    width: var(--cover-rail-w);
  }
  .cover-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    box-shadow: var(--cover-shadow);
  }
  .badge {
    position: absolute;
    top: -6px;
    right: -8px;
    height: 22px;
    padding: 0 7px;
    border-radius: 11px;
    background: var(--accent);
    color: var(--accent-ink);
    font-family: var(--font-ui);
    font-size: 11px;
    font-weight: 700;
    display: flex;
    align-items: center;
  }
</style>
