---
/**
 * Item de carrossel: capa + título e autoria em texto SOB a capa (handoff §9 —
 * o texto nunca mora só na imagem). O item inteiro é um link para a obra.
 *
 * Compõe o componente Capa da S1: herda a capa tipográfica (nenhuma capa de
 * obra existe ainda), o selo "2×" das releituras e o `lang`/`dir` dos títulos
 * não latinos. Recebe uma WorkView já resolvida (a página não passa o catálogo
 * cru).
 */
import Cover from "@/components/Cover.astro";
import type { WorkView } from "@/lib/catalog/model.ts";
import { detectScript, originalTitleLang, scriptDir } from "@/lib/text.ts";

interface Props {
  work: WorkView;
  href: string;
  size?: "hero" | "rail" | "grid";
  /** Mostra o título original (itálico, com lang/dir) sob o título (S4). */
  showOriginal?: boolean;
}

const { work, href, size = "rail", showOriginal = false } = Astro.props;
const authorNames = work.authors.map((a) => a.name).join("; ");

// Título original: só quando existe e difere do pt-BR.
const original =
  showOriginal &&
  work.originalTitle != null &&
  work.originalTitle.trim() !== "" &&
  work.originalTitle.trim() !== work.title.trim()
    ? work.originalTitle
    : null;
const script = original ? detectScript(original) : "latin";
const originalDir = scriptDir(script);
const originalLang = original ? originalTitleLang(work.language, original) : undefined;
const originalFont =
  script === "cjk"
    ? work.language === "coreano"
      ? "var(--font-serif-kr)"
      : "var(--font-serif-jp)"
    : script === "hebrew"
      ? "var(--font-serif-hebrew)"
      : null;
---

<a class:list={["item", `size-${size}`]} href={href}>
  <Cover
    title={work.title}
    language={work.language}
    originalTitle={work.originalTitle}
    author={authorNames}
    rereadBadge={work.reread}
    size={size}
  />
  <span class="caption">
    <span class="title">{work.title}</span>
    {
      original && (
        <span
          class="original"
          lang={originalLang}
          dir={originalDir}
          style={originalFont ? `font-family:${originalFont};` : undefined}
        >
          {original}
        </span>
      )
    }
    {authorNames && <span class="author">{authorNames}</span>}
  </span>
</a>

<style>
  .item {
    display: flex;
    flex-direction: column;
    gap: 8px;
    text-decoration: none;
    color: inherit;
  }
  .size-hero {
    width: var(--cover-hero-w);
  }
  .size-rail {
    width: var(--cover-rail-w);
  }
  /* Na grade, o item ocupa a largura da coluna (não largura fixa). */
  .size-grid {
    width: 100%;
    /* Na grade o item nunca é mais largo que a coluna (palavra longa no título
       ou na autoria quebra em vez de alargar a coluna). */
    min-width: 0;
  }
  .size-grid .caption {
    min-width: 0;
    overflow-wrap: anywhere;
  }
  .caption {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .title {
    font-family: var(--font-ui);
    font-size: 13px;
    font-weight: 600;
    line-height: 1.25;
    color: var(--text);
    /* até 2 linhas, com reticências */
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    overflow: hidden;
  }
  .original {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 12px;
    line-height: 1.25;
    color: var(--muted);
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    overflow: hidden;
  }
  .author {
    font-family: var(--font-ui);
    font-size: 11px;
    color: var(--faint);
    line-height: 1.2;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 1;
    line-clamp: 1;
    overflow: hidden;
  }
  .item:hover .title {
    text-decoration: underline;
  }
</style>
