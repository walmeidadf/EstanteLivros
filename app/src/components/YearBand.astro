---
/**
 * Faixa do ano (handoff §4) — uma linha clicável com o rótulo (o ano, na linha
 * do tempo; o país, na S4), notas opcionais, a contagem "N ›" em --accent e,
 * embaixo, uma fileira de lombadas mini sobre a prateleira.
 *
 * Genérica: não conhece o catálogo. Recebe tudo pronto de quem a usa — na S3,
 * a página da Linha do tempo (via timeline.ts); na S4, a prateleira por país.
 * As notas e a ordem das lombadas são decididas fora (nunca aqui).
 *
 * A fileira de lombadas é decorativa (aria-hidden): o ano e a contagem já estão
 * em texto no link (handoff §10). Reusa Spine (lombada mini) e Shelf
 * (prateleira) da S1. Renderiza sem JavaScript.
 */
import Spine from "@/components/Spine.astro";
import Shelf from "@/components/Shelf.astro";

interface Props {
  /** Rótulo principal (o ano "2024"; o nome do país na S4). */
  label: string;
  /** Destino da linha inteira. Sem `href`, a faixa não é link (S4: "Outros países"). */
  href?: string;
  /** Contagem exibida como "N ›" (sem o "›" quando não há link). */
  count: number;
  /** Notas automáticas curtas (0..n); vazio na prateleira por país. */
  notes?: string[];
  /** Uma lombada por item, na ordem recebida. */
  spines: { language: string }[];
  /**
   * Uma prateleira por linha de lombadas (S4). Para faixas com muitas lombadas,
   * que quebram em várias linhas: cada linha ganha a sua prateleira, em vez de
   * uma só sob a última. Padrão false = markup e CSS da Linha do tempo (S3).
   */
  shelfPerRow?: boolean;
}

const {
  label,
  href,
  count,
  notes = [],
  spines,
  shelfPerRow = false,
} = Astro.props;
const Tag = href ? "a" : "div";
---

<Tag class="band" href={href}>
  <span class="line">
    <span class="label">{label}</span>
    {
      notes.length > 0 && (
        <span class="notes">
          {notes.map((note, i) => (
            <>
              {i > 0 && <span class="dot" aria-hidden="true">·</span>}
              <span class="note">{note}</span>
            </>
          ))}
        </span>
      )
    }
    <span class="count">{href ? `${count} ›` : count}</span>
  </span>

  <span class="shelf-wrap" aria-hidden="true">
    <span class:list={["spines", { "per-row": shelfPerRow }]}>
      {spines.map((s, i) => <Spine language={s.language} index={i} />)}
    </span>
    {!shelfPerRow && <Shelf />}
  </span>
</Tag>

<style>
  .band {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 12px var(--gutter);
    min-height: var(--tap);
    text-decoration: none;
    color: var(--text);
    border-top: 1px solid var(--line-soft);
    /* a faixa nunca é mais larga que seu contêiner (evita rolagem lateral) */
    max-width: 100%;
    min-width: 0;
  }
  a.band:hover .label {
    text-decoration: underline;
  }

  .line {
    display: flex;
    align-items: baseline;
    gap: 10px;
  }
  .label {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 22px;
    color: var(--title);
    flex: 0 0 auto;
  }
  .notes {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 6px;
    /* ocupa o meio, mas cede espaço à contagem (que nunca some) */
    flex: 1 1 auto;
    min-width: 0;
  }
  .note {
    font-family: var(--font-ui);
    font-size: 12px;
    color: var(--faint);
  }
  .dot {
    color: var(--faint);
    font-size: 12px;
  }
  .count {
    margin-left: auto;
    font-family: var(--font-ui);
    font-size: 14px;
    font-weight: 600;
    color: var(--accent);
    white-space: nowrap;
  }

  .shelf-wrap {
    display: flex;
    flex-direction: column;
    gap: 0;
    max-width: 100%;
  }
  .spines {
    display: flex;
    align-items: flex-end;
    gap: 3px;
    /* Em anos cheios, a fileira quebra em linhas; nunca vira carrossel. */
    flex-wrap: wrap;
    row-gap: 6px;
    min-height: 48px;
    max-width: 100%;
  }

  /* Uma prateleira por linha: células de altura fixa (lombada mais alta 48px +
     prateleira), lombadas apoiadas no topo da prateleira de cada linha. */
  .spines.per-row {
    display: grid;
    grid-template-columns: repeat(auto-fill, 4px);
    column-gap: 3px;
    row-gap: 0;
    grid-auto-rows: calc(48px + var(--shelf-height));
    align-items: end;
    min-height: 0;
    background: repeating-linear-gradient(
      to bottom,
      transparent 0,
      transparent 48px,
      var(--wood-top) 48px,
      var(--wood-bottom) calc(48px + var(--shelf-height))
    );
  }
  .spines.per-row > :global(.spine) {
    margin-bottom: var(--shelf-height);
  }
</style>
