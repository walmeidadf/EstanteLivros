---
/**
 * Carrossel de avatares de autoria (handoff §6.1, §6.6): título de seção e uma
 * fileira rolável com `scroll-snap`, sem barra de rolagem. Os itens
 * (`AuthorChip`) entram pelo slot. Usado no Início ("Quem sempre volta") e na
 * tela Idioma.
 */
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<section class="authors">
  <div class="head">
    <h2 class="t-section-title">{title}</h2>
  </div>
  <div class="author-rail">
    <slot />
  </div>
</section>

<style>
  .authors {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .authors .head {
    padding-inline: var(--gutter);
  }
  .authors .head h2 {
    color: var(--title);
  }
  .author-rail {
    display: flex;
    gap: 16px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding-inline: var(--gutter);
    padding-bottom: 4px;
    scrollbar-width: none;
    scroll-padding-inline: var(--gutter);
  }
  .author-rail::-webkit-scrollbar {
    display: none;
  }
  .author-rail > :global(*) {
    scroll-snap-align: start;
  }
</style>
