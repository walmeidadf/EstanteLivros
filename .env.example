# Copie para `.env` (fora do git) e preencha as chaves:
#   cp .env.example .env
#
# Usado pelos scripts de enriquecimento em pipeline/. O app nunca lê este arquivo.

# OpenAI: resumo e tradução das bios (e, depois, resumos de ano e país).
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Modelo pequeno e barato. Confira os nomes disponíveis na sua conta.
OPENAI_MODEL=gpt-5.4-mini

# Tavily: fontes para a bio e fotos candidatas quando Wikipédia/Commons não bastam.
# 1.000 créditos grátis por mês. https://app.tavily.com
TAVILY_API_KEY=

# SerpApi (opcional): Google Imagens para fotos candidatas, com dimensões.
# Sem chave, a etapa usa só Wikipédia e Tavily. https://serpapi.com/manage-api-key
SERP_API_KEY=

# Preço do OPENAI_MODEL em US$ por milhão de tokens, só para estimar custos.
# Confira em https://platform.openai.com/pricing
OPENAI_PRICE_INPUT_PER_M=0.75
OPENAI_PRICE_OUTPUT_PER_M=4.50

# Wikidata, Wikipédia e Commons não precisam de chave, mas pedem um User-Agent
# identificável com um contato.
WIKIMEDIA_USER_AGENT=EstanteDaLila/0.1 (https://github.com/walmeidadf/EstanteLivros; seu-email@exemplo.com)

# Idiomas da Wikipédia consultados em ordem (o primeiro que tiver o verbete vence).
# O resumo sai sempre em pt-BR, traduzido quando a fonte for de outro idioma.
BIO_SOURCE_LANGUAGES=pt,en,es,fr,it
