{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://estante-da-lila/schema/work.schema.json",
  "title": "Obra",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "slug", "title", "originalTitle", "originalTitleRomanized", "authors",
    "language", "firstPublished", "type", "genres", "themes", "edition", "cover",
    "catalogerNote", "confidence", "references", "legacyId", "audit"
  ],
  "properties": {
    "slug": { "$ref": "#/$defs/slug" },
    "title": { "$ref": "#/$defs/text" },
    "originalTitle": { "$ref": "#/$defs/optionalText" },
    "originalTitleRomanized": { "$ref": "#/$defs/optionalText" },
    "authors": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/slug" }
    },
    "language": { "$ref": "#/$defs/text" },
    "firstPublished": { "$ref": "#/$defs/optionalYear" },
    "type": { "$ref": "#/$defs/text" },
    "genres": { "$ref": "#/$defs/textList" },
    "themes": { "$ref": "#/$defs/textList" },
    "tags": { "$ref": "#/$defs/textList" },
    "edition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "language", "publisher", "year", "isbn13", "isbn10", "format", "match"],
      "properties": {
        "title": { "$ref": "#/$defs/optionalText" },
        "language": { "$ref": "#/$defs/optionalText" },
        "publisher": { "$ref": "#/$defs/optionalText" },
        "year": { "$ref": "#/$defs/optionalYear" },
        "isbn13": { "type": ["string", "null"], "pattern": "^97[89][0-9]{10}$" },
        "isbn10": { "type": ["string", "null"], "pattern": "^[0-9]{9}[0-9X]$" },
        "format": { "$ref": "#/$defs/optionalText" },
        "match": { "enum": ["exact", "representative"] }
      }
    },
    "cover": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["sourceUrl", "source"],
          "properties": {
            "sourceUrl": { "type": "string", "pattern": "^https?://" },
            "source": { "$ref": "#/$defs/optionalText" },
            "file": {
              "type": ["string", "null"],
              "pattern": "^covers/[a-z0-9]+(-[a-z0-9]+)*\\.(jpg|png|webp|gif)$"
            },
            "license": { "$ref": "#/$defs/optionalText" },
            "credit": { "$ref": "#/$defs/optionalText" },
            "focus": { "enum": ["top", "center", "bottom", null] },
            "display": { "enum": ["typographic", null] }
          }
        }
      ]
    },
    "catalogerNote": { "$ref": "#/$defs/optionalText" },
    "confidence": { "enum": ["high", "medium", "low"] },
    "references": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["provider", "id", "url", "fields"],
        "properties": {
          "provider": { "enum": ["literal", "openlibrary", "google_books", "wikidata", "web"] },
          "id": { "$ref": "#/$defs/optionalText" },
          "url": { "type": ["string", "null"], "pattern": "^https?://" },
          "fields": { "$ref": "#/$defs/optionalText" }
        }
      }
    },
    "legacyId": { "type": ["string", "null"], "minLength": 1 },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["validationStatus", "sourceConflicts", "validatedAt"],
      "properties": {
        "validationStatus": { "$ref": "#/$defs/optionalText" },
        "sourceConflicts": { "$ref": "#/$defs/optionalText" },
        "validatedAt": { "type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "overrides": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["originalTitle", "originalTitleRomanized", "firstPublished"] }
        }
      }
    }
  },
  "$defs": {
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 80 },
    "text": { "type": "string", "minLength": 1 },
    "optionalText": { "type": ["string", "null"], "minLength": 1 },
    "textList": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "optionalYear": { "type": ["integer", "null"], "minimum": 1000, "maximum": 2100 }
  }
}
