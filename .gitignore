# Sistema
.DS_Store

# Área de trabalho descartável do agente (screenshots, dumps, builds de
# verificação). Fica DENTRO do projeto para não precisar de aprovação a cada
# escrita fora do workspace. Nada aqui é versionado, exceto o .gitkeep.
temp/*
!temp/.gitkeep

# Legado (mantido só localmente como referência e fonte da migração)
legacy/

# Design: o zip duplica o conteúdo de design/
design/*.zip

# Python
__pycache__/
*.pyc
.venv/
.pycache/

# Node / Astro
node_modules/
dist/
.astro/

# Pipeline: respostas de APIs e folhas de revisão locais
pipeline/cache/
docs/plans/revisao-fotos.html
docs/plans/revisao-capas.html

# Infra
cdk.out/
.wrangler/

# Segredos
.env
.env.*
!.env.example
